@startuml c4_L1
!include <C4/C4_Context>
skinparam dpi 150
skinparam defaultFontName "DejaVu Sans"
LAYOUT_TOP_DOWN()
HIDE_STEREOTYPE()
AddElementTag("backlog", $bgColor="#bdbdbd", $fontColor="#212121", $borderColor="#9e9e9e")
AddRelTag("backlog", $textColor="#757575", $lineColor="#9e9e9e", $lineStyle=DashedLine())

title C4 · Уровень 1 · Системный контекст · Helios

Person(emp, "Сотрудник", "Работник компании")
Person(mgr, "Менеджер", "Работник компании, который организует обеды")
Person(adm, "Администратор", "Работник компании, который сопровождает систему")
Person_Ext(rest, "Ресторан", "Поставщик обедов для сотрудников")

System(sys, "Helios", "Веб-приложение для бронирования обедов")

System_Ext(iiko, "iiko (бэклог)", "Система автоматизации ресторана", $tags="backlog")
System_Ext(mail, "Почтовый сервис (бэклог)", "Сервис электронной почты", $tags="backlog")
System_Ext(ya, "Яндекс ID (бэклог)", "Сервис входа по аккаунту Яндекса", $tags="backlog")

Rel_D(emp, sys, "Бронирует обед", "HTTPS")
Rel_D(mgr, sys, "Ведет меню, зал", "HTTPS")
Rel_D(adm, sys, "Назначает роли", "HTTPS")
Rel_L(mgr, rest, "Передает отчет")
Rel_D(sys, iiko, "Передает обеды", "HTTPS", $tags="backlog")
Rel_U(iiko, sys, "Передает меню", "HTTPS", $tags="backlog")
Rel_D(sys, mail, "Отправляет отчет", "SMTP", $tags="backlog")
Rel_D(sys, ya, "Проверяет вход", "HTTPS", $tags="backlog")

Lay_R(rest, mgr)
Lay_R(mgr, emp)
Lay_R(emp, adm)
Lay_R(iiko, mail)
Lay_R(mail, ya)
@enduml
