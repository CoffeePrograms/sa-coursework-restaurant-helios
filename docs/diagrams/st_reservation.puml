@startuml st_reservation
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam dpi 150
hide empty description
skinparam state {
  BackgroundColor #FEFECE
  BorderColor #555555
  ArrowColor #333333
}

state "Активна\n(IsDeleted = false)" as Act
state "Удалена\n(IsDeleted = true)" as Del

[*] --> Act : сотрудник подтвердил бронь\n(POST /api/Reservation)
Act --> Act : бронь изменена\n(PUT /api/Reservation)
Act --> Del : бронь удалена\n(DELETE /api/Reservation)
Del --> [*]
note left of Act : Отдельного поля статуса нет.\nПрошедшая дата обеда\nстатус не меняет.
note left of Del : Запись остается в базе,\nв схему зала и отчет\nне попадает.
@enduml
